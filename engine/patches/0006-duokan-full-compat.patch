+// Locate a single dominant image inside a Duokan fullscreen/fitwindow DocFragment
+// (OPF spine properties="duokan-page-fullscreen" / "duokan-page-fitwindow").
+// Returns NULL if the fragment has significant body text or no image.
+static ldomNode * findDuokanFullscreenImageNode(ldomNode * node, int & text_chars, int & img_count) {
+    if (!node)
+        return NULL;
+    if (node->isText()) {
+        lString32 t = node->getText();
+        t.trim();
+        text_chars += t.length();
+        return NULL;
+    }
+    if (node->isElement()) {
+        lUInt16 id = node->getNodeId();
+        if (id == el_img || id == el_image || id == el_svg) {
+            img_count++;
+            return node;
+        }
+        ldomNode * found = NULL;
+        for (int i = 0; i < node->getChildCount(); i++) {
+            ldomNode * child_img = findDuokanFullscreenImageNode(node->getChildNode(i), text_chars, img_count);
+            if (child_img && !found)
+                found = child_img;
+        }
+        return found;
+    }
+    return NULL;
+}
+
+static ldomNode * findDuokanFullscreenFragmentAt(ldomDocument * doc, int page_start, int page_height) {
+    if (!doc || page_height <= 0)
+        return NULL;
+    ldomNode * root = doc->getRootNode();
+    if (!root)
+        return NULL;
+    // Traverse top-level DocFragments under body/fictionbook/root
+    lvRect page_rc(0, page_start, 0x3FFFFFFF, page_start + page_height);
+    ldomNode * body = root->findChildElement(LXML_NS_ANY, el_body, -1);
+    ldomNode * container = body ? body : root;
+    for (int i = 0; i < container->getChildCount(); i++) {
+        ldomNode * frag = container->getChildNode(i);
+        if (!frag || !frag->isElement() || frag->getNodeId() != el_DocFragment)
+            continue;
+        lvRect frc;
+        frag->getAbsRect(frc);
+        if (frc.bottom <= page_rc.top || frc.top >= page_rc.bottom)
+            continue;
+        lString32 tprop = frag->getAttributeValue(LXML_NS_ANY, attr_T);
+        if (tprop.pos(U"duokan-page-fullscreen") >= 0 || tprop.pos(U"duokan-page-fitwindow") >= 0) {
+            return frag;
+        }
+    }
+    return NULL;
+}
+
+// Check if the first rendered block at the top of this page carries CSS_CR_HINT_DUOKAN_BLEED_TOP.
+static bool pageHasTopBleedBlock(ldomNode * node, int page_start, int tolerance) {
+    if (!node || !node->isElement())
+        return false;
+    lvRect rc;
+    node->getAbsRect(rc);
+    if (rc.bottom <= page_start || rc.top > page_start + tolerance)
+        return false;
+    css_style_ref_t st = node->getStyle();
+    if (!st.isNull() && STYLE_HAS_CR_HINT(st, DUOKAN_BLEED_TOP) && rc.top >= page_start - tolerance) {
+        return true;
+    }
+    for (int i = 0; i < node->getChildCount(); i++) {
+        if (pageHasTopBleedBlock(node->getChildNode(i), page_start, tolerance))
+            return true;
+    }
+    return false;
+}
