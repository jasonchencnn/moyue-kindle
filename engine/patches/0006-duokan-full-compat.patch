+static int resolveBorderRadiusPx(const css_style_ref_t & style, int box_w, int box_h)
+{
+    int step = STYLE_GET_BORDER_RADIUS_STEP(style);
+    if ( step <= 0 || box_w <= 2 || box_h <= 2 )
+        return 0;
+    // step 1..7 -> 2..14 CSS px, scaled moderately by DPI relative to 96
+    int r = (step * 2 * (gRenderDPI > 0 ? gRenderDPI : 96) + 48) / 96;
+    int max_r = (box_w < box_h ? box_w : box_h) / 2;
+    if ( r > max_r )
+        r = max_r;
+    return r;
+}
+
+static int roundedCornerInset(int r, int dy_from_edge)
+{
+    // dy_from_edge in [0, r-1]: distance from outer edge to scanline center
+    if ( r <= 0 || dy_from_edge >= r )
+        return 0;
+    double cy = (double)r - ((double)dy_from_edge + 0.5);
+    double r2 = (double)r * (double)r;
+    double dx2 = r2 - cy * cy;
+    if ( dx2 <= 0.0 )
+        return r;
+    int inset = (int)( (double)r - sqrt(dx2) + 0.5 );
+    if ( inset < 0 ) inset = 0;
+    if ( inset > r ) inset = r;
+    return inset;
+}
+
+static void FillRoundedRect(LVDrawBuf & drawbuf, int x0, int y0, int x1, int y1, int r, lUInt32 color)
+{
+    if ( x1 <= x0 || y1 <= y0 )
+        return;
+    if ( r <= 1 ) {
+        drawbuf.FillRect(x0, y0, x1, y1, color);
+        return;
+    }
+    int max_r = ((x1 - x0) < (y1 - y0) ? (x1 - x0) : (y1 - y0)) / 2;
+    if ( r > max_r )
+        r = max_r;
+    for ( int i = 0; i < r; i++ ) {
+        int inset = roundedCornerInset(r, i);
+        int lx = x0 + inset;
+        int rx = x1 - inset;
+        if ( rx > lx ) {
+            drawbuf.FillRect(lx, y0 + i, rx, y0 + i + 1, color);
+            drawbuf.FillRect(lx, y1 - 1 - i, rx, y1 - i, color);
+        }
+    }
+    if ( y1 - r > y0 + r ) {
+        drawbuf.FillRect(x0, y0 + r, x1, y1 - r, color);
+    }
+}
