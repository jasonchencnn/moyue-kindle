+    lString8 findRegisteredFamilyByKeywords(const char * const * keywords, css_font_family_t preferred_css_family) const
+    {
+        for (int k = 0; keywords[k] != NULL; k++) {
+            lString8 kw(keywords[k]);
+            kw.lowercase();
+            for (int i = 0; i < _registry.familyCount(); i++) {
+                const LVFontFamily * fam = _registry.familyAt(i);
+                if (!fam || fam->faceCount() <= 0)
+                    continue;
+                lString8 name = fam->getName();
+                name.lowercase();
+                if (name.pos(kw) >= 0) {
+                    return fam->faceAt(0).typeface;
+                }
+            }
+        }
+        if (preferred_css_family != css_ff_inherit) {
+            for (int i = 0; i < _registry.familyCount(); i++) {
+                const LVFontFamily * fam = _registry.familyAt(i);
+                if (fam && fam->faceCount() > 0 && fam->faceAt(0).css_family == preferred_css_family) {
+                    return fam->faceAt(0).typeface;
+                }
+            }
+        }
+        return lString8::empty_str;
+    }
+
+    // Expand Duokan (多看) built-in font aliases ("DK-SONGTI", "DK-HEITI", "DK-KAITI",
+    // "DK-FANGSONG", "DK-XIAOBIAOSONG", "DK-XIHEITI", "DK-CODE", "DK-SERIF") to
+    // matching registered families on the host/device.
+    lString8 resolveDuokanTypeface(const lString8 & typeface, css_font_family_t & css_family) const
+    {
+        if (typeface.empty() || (typeface.pos("DK-") < 0 && typeface.pos("dk-") < 0)) {
+            return typeface;
+        }
+        static const char * const kSongKeywords[] = {
+            "xiaobiaosong", "song", "ming", "serif", "宋体", "小标宋", "书宋", NULL
+        };
+        static const char * const kHeiKeywords[] = {
+            "hei", "noto sans", "pingfang", "sans", "gothic", "黑体", NULL
+        };
+        static const char * const kKaiKeywords[] = {
+            "kai", "wenkai", "lxgw", "楷", NULL
+        };
+        static const char * const kFangKeywords[] = {
+            "fangsong", "fang", "仿宋", NULL
+        };
+        static const char * const kCodeKeywords[] = {
+            "mono", "courier", "consolas", "menlo", "code", "dejavu sans mono", NULL
+        };
+
+        lString8 out;
+        int start = 0;
+        const int len = typeface.length();
+        while (start <= len) {
+            int comma = typeface.pos(",", start);
+            lString8 token = (comma < 0) ? typeface.substr(start) : typeface.substr(start, comma - start);
+            token.trim();
+            // Strip surrounding quotes if present
+            if (token.length() >= 2 &&
+                ((token[0] == '"' && token[token.length() - 1] == '"') ||
+                 (token[0] == '\'' && token[token.length() - 1] == '\''))) {
+                token = token.substr(1, token.length() - 2);
+                token.trim();
+            }
+            lString8 upper = token;
+            upper.uppercase();
+            lString8 mapped;
+            if (upper == "DK-SONGTI" || upper == "DK-XIAOBIAOSONG" || upper == "DK-SERIF") {
+                mapped = findRegisteredFamilyByKeywords(kSongKeywords, css_ff_serif);
+                if (css_family == css_ff_inherit) css_family = css_ff_serif;
+            } else if (upper == "DK-HEITI" || upper == "DK-XIHEITI") {
+                mapped = findRegisteredFamilyByKeywords(kHeiKeywords, css_ff_sans_serif);
+                if (css_family == css_ff_inherit) css_family = css_ff_sans_serif;
+            } else if (upper == "DK-KAITI") {
+                mapped = findRegisteredFamilyByKeywords(kKaiKeywords, css_ff_cursive);
+                if (mapped.empty()) mapped = findRegisteredFamilyByKeywords(kSongKeywords, css_ff_serif);
+            } else if (upper == "DK-FANGSONG") {
+                mapped = findRegisteredFamilyByKeywords(kFangKeywords, css_ff_serif);
+                if (mapped.empty()) mapped = findRegisteredFamilyByKeywords(kSongKeywords, css_ff_serif);
+            } else if (upper == "DK-CODE") {
+                mapped = findRegisteredFamilyByKeywords(kCodeKeywords, css_ff_monospace);
+                css_family = css_ff_monospace;
+            }
+            const lString8 & chosen = mapped.empty() ? token : mapped;
+            if (!chosen.empty()) {
+                if (!out.empty()) out << ", ";
+                out << chosen;
+            }
+            if (comma < 0) break;
+            start = comma + 1;
+        }
+        return out.empty() ? typeface : out;
+    }
