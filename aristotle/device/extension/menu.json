{
  "items": [
    {
      "name": "墨阅",
      "items": [
        {
          "name": "启动墨阅",
          "action": "sh ./bin/aristotle-start.sh",
          "exitmenu": true,
          "status": false
        },
        {
          "name": "返回 Kindle 系统",
          "action": "sh ./bin/aristotle-stop.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "检查更新（OTA，需 Wi-Fi）",
          "items": [
            {
              "name": "检查并安装最新预览版（会先停墨阅）",
              "action": "sh ./bin/ota-update.sh install",
              "exitmenu": false,
              "status": false
            },
            {
              "name": "取消",
              "action": "true",
              "exitmenu": false,
              "status": false
            }
          ]
        },
        {
          "name": "开机启动墨阅：开（需已安装 agent）",
          "action": "sh ./agent/autostart.sh on",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "开机启动墨阅：关",
          "action": "sh ./agent/autostart.sh off",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "恢复上一个开机版本（阅读数据不变）",
          "action": "sh ./agent/autostart.sh rollback",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "安装 agent（每次开机提供 SSH，阻止亚马逊更新）",
          "action": "sh ./agent/install.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "USB 磁盘模式 10 分钟（需已安装 agent）",
          "action": "sh /var/local/aristotle/aristotlectl mode storage 10",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "完全移除 agent（服务、状态、SSH 密钥）",
          "action": "sh ./agent/uninstall.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "诊断日志",
          "items": [
            {
              "name": "1. 采集日志（复现问题后点击）",
              "action": "sh ./diagnostics/diagnostics.sh collect",
              "exitmenu": false,
              "status": false
            },
            {
              "name": "2. 上传日志（可能含书名与路径）",
              "items": [
                {
                  "name": "同意发送到开发者服务器",
                  "action": "sh ./diagnostics/diagnostics.sh upload",
                  "exitmenu": false,
                  "status": false
                },
                {
                  "name": "取消",
                  "action": "true",
                  "exitmenu": false,
                  "status": false
                }
              ]
            }
          ]
        },
        {
          "name": "本次启动 USB 网络（手动）",
          "action": "sh ./bin/start.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "停止 USB 网络（手动）",
          "action": "sh ./bin/stop.sh",
          "exitmenu": false,
          "status": false
        }
      ]
    }
  ]
}
