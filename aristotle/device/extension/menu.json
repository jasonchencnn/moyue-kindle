{
  "items": [
    {
      "name": "墨阅",
      "items": [
        {
          "name": "启动墨阅",
          "action": "sh ./bin/aristotle-start.sh",
          "exitmenu": true,
          "status": false
        },
        {
          "name": "返回 Kindle 系统",
          "action": "sh ./bin/aristotle-stop.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "开机启动墨阅：开（需已安装 agent）",
          "action": "sh ./agent/autostart.sh on",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "开机启动墨阅：关",
          "action": "sh ./agent/autostart.sh off",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "恢复上一个开机版本（阅读数据不变）",
          "action": "sh ./agent/autostart.sh rollback",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "安装 agent（每次开机提供 SSH，阻止亚马逊更新）",
          "action": "sh ./agent/install.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "USB 磁盘模式 10 分钟（需已安装 agent）",
          "action": "sh /var/local/aristotle/aristotlectl mode storage 10",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "完全移除 agent（服务、状态、SSH 密钥）",
          "action": "sh ./agent/uninstall.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "本次启动 USB 网络（手动）",
          "action": "sh ./bin/start.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "停止 USB 网络（手动）",
          "action": "sh ./bin/stop.sh",
          "exitmenu": false,
          "status": false
        }
      ]
    }
  ]
}
