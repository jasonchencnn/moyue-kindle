        "remote": {
          "user_id": "usr-01",
          "book_hash": "d4e5f6a1b2c30718293a4b5c6d7e8f93",
          "format": "EPUB",
          "title": "红楼梦",
          "author": "曹雪芹",
          "updated_at": "2026-11-05T08:00:00.000Z",
          "deleted_at": "2026-11-05T12:00:00.000Z"
        }
      },
      "expected": {
        "winner": "local",
        "result": {
          "user_id": "usr-01",
          "book_hash": "d4e5f6a1b2c30718293a4b5c6d7e8f93",
          "format": "EPUB",
          "title": "红楼梦",
          "author": "曹雪芹",
          "updated_at": "2026-11-05T10:00:00.000Z",
          "deleted_at": null
        }
      }
    },
